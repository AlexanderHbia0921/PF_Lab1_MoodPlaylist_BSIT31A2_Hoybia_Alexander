@model MoodPlaylistGenerator.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<!-- Modern Login Form -->
<section class="auth-section py-5">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <!-- Welcome Back Card -->
                <div class="auth-card card border-0 shadow-lg">
                    <div class="card-body p-4 p-md-5">
                        <!-- Header Section -->
                        <div class="text-center mb-5">
                            <div class="auth-icon mb-3">
                                <i class="fas fa-music text-primary fs-1"></i>
                            </div>
                            <h2 class="fw-bold mb-2 text-dark">Welcome Back!</h2>
                            <p class="text-muted mb-0">Sign in to continue to your music journey</p>
                        </div>

                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success border-0 rounded-3 mb-4">
                                <i class="fas fa-check-circle me-2"></i>@TempData["Message"]
                            </div>
                        }

                        <form asp-action="Login" method="post" class="modern-form">
                            <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 mb-4" style="display: none;"></div>
                            
                            <!-- Email/Username Field -->
                            <div class="modern-input mb-4">
                                <input asp-for="EmailOrUsername" type="text" class="form-control" placeholder=" " required />
                                <label asp-for="EmailOrUsername">Email or Username</label>
                                <div class="input-icon">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="modern-input mb-4">
                                <input asp-for="Password" type="password" class="form-control" placeholder=" " required />
                                <label asp-for="Password">Password</label>
                                <div class="input-icon">
                                    <i class="fas fa-lock"></i>
                                </div>
                                <button type="button" class="password-toggle" onclick="togglePassword(this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me & Forgot Password -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                                    <label asp-for="RememberMe" class="form-check-label text-muted">Remember me</label>
                                </div>
                                <a asp-action="ForgotPassword" class="text-primary text-decoration-none small fw-medium">Forgot password?</a>
                            </div>

                            <!-- Login Button -->
                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-primary btn-lg py-3 fw-semibold">
                                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                                </button>
                            </div>
                        </form>

                        <!-- Divider -->
                        <div class="divider my-4">
                            <span class="text-muted small">or</span>
                        </div>

                        <!-- Social Login (Future Enhancement) -->
                        <div class="d-grid gap-2 mb-4">
                            <button type="button" class="btn btn-outline-dark btn-lg py-3" disabled>
                                <i class="fab fa-google me-2"></i>Continue with Google
                                <small class="text-muted ms-2">(Coming Soon)</small>
                            </button>
                        </div>

                        <!-- Register Link -->
                        <div class="text-center">
                            <p class="text-muted mb-0">
                                New to MoodTunes? 
                                <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Create account</a>
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Features Highlight -->
                <div class="text-center mt-4">
                    <div class="row g-3">
                        <div class="col-4">
                            <div class="feature-highlight">
                                <i class="fas fa-shield-alt text-primary mb-2"></i>
                                <small class="text-muted d-block">Secure</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="feature-highlight">
                                <i class="fas fa-bolt text-warning mb-2"></i>
                                <small class="text-muted d-block">Fast</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="feature-highlight">
                                <i class="fas fa-heart text-danger mb-2"></i>
                                <small class="text-muted d-block">Loved</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Password toggle functionality
        function togglePassword(button) {
            const input = button.previousElementSibling.previousElementSibling;
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
        
        // Form validation enhancement
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('.modern-form');
            const validationSummary = document.querySelector('[data-valmsg-summary="true"]');
            
            if (form) {
                form.addEventListener('submit', function() {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.innerHTML = '<span class="loading-spinner me-2"></span>Signing In...';
                        submitBtn.disabled = true;
                    }
                });
            }
            
            // Show validation summary if there are errors
            if (validationSummary && validationSummary.innerHTML.trim() !== '') {
                validationSummary.style.display = 'block';
            }
            
            // Enhanced input animations
            const inputs = document.querySelectorAll('.modern-input input');
            inputs.forEach(input => {
                // Add focus animations
                input.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                
                input.addEventListener('blur', function() {
                    if (!this.value) {
                        this.parentElement.classList.remove('focused');
                    }
                });
                
                // Check if input has value on page load
                if (input.value) {
                    input.parentElement.classList.add('focused');
                }
            });
        });
    </script>
}
