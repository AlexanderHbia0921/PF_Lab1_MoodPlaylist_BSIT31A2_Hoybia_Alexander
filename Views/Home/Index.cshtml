@{
    ViewData["Title"] = "Mood Playlist Generator";
}

<!-- Modern Enhanced Hero Section -->
<section class="hero-section bg-gradient bg-pattern text-white position-relative overflow-hidden">
    <!-- Background Elements -->
    <div class="position-absolute top-0 start-0 w-100 h-100">
        <div class="floating-shapes">
            <div class="shape-1"></div>
            <div class="shape-2"></div>
            <div class="shape-3"></div>
        </div>
    </div>
    
    <div class="container-fluid px-3 px-md-4 position-relative">
        <div class="row align-items-center justify-content-center min-vh-75 g-5 py-5">
            <div class="col-12 col-lg-6 order-lg-1">
                <div class="hero-content text-center text-lg-start animate-fade-in-left">
                    <!-- Eye-catching Badge -->
                    <div class="hero-badge d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 backdrop-blur rounded-pill px-4 py-2 mb-4">
                        <span class="badge bg-success">New</span>
                        <span class="text-white-50 small">AI-Powered Mood Detection</span>
                    </div>
                    
                    <h1 class="display-2 fw-bold mb-4 lh-1">
                        <span class="text-white">Create Your Perfect</span>
                        <br>
                        <span class="text-gradient fw-bold position-relative">
                            Mood Playlists
                            <svg class="hero-underline" viewBox="0 0 300 12" fill="none">
                                <path d="M5 6C100 2 200 2 295 6" stroke="#ffd700" stroke-width="3" stroke-linecap="round"/>
                            </svg>
                        </span>
                    </h1>
                    
                    <p class="lead mb-5 fs-4 text-white-75 pe-lg-5">
                        Transform your music experience with intelligent mood detection. 
                        Organize your favorite YouTube songs and generate personalized playlists 
                        that match your vibe perfectly.
                    </p>
                    
                    <!-- Enhanced Feature Pills -->
                    <div class="feature-pills d-flex flex-wrap gap-2 mb-5 justify-content-center justify-content-lg-start">
                        <span class="pill"><i class="fas fa-brain me-1"></i> AI-Powered</span>
                        <span class="pill"><i class="fab fa-youtube me-1"></i> YouTube Integration</span>
                        <span class="pill"><i class="fas fa-mobile-alt me-1"></i> Mobile Friendly</span>
                        <span class="pill"><i class="fas fa-heart me-1"></i> Mood-Based</span>
                    </div>
                
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <div class="hero-actions d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-4">
                            <a href="/Account/Register" class="btn btn-light btn-lg hover-lift px-4 py-3">
                                <i class="fas fa-rocket me-2"></i>Start Free
                            </a>
                            <a href="/Account/Login" class="btn btn-outline-light btn-lg hover-lift px-4 py-3">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </a>
                        </div>
                        
                        <div class="hero-stats mt-5">
                            <div class="row text-center g-3">
                                <div class="col-12 col-sm-4">
                                    <div class="stat-item">
                                        <h3 class="fw-bold mb-1 fs-2 fs-sm-1 text-white">10K+</h3>
                                        <small class="text-white-50 d-block">Songs Organized</small>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <div class="stat-item">
                                        <h3 class="fw-bold mb-1 fs-2 fs-sm-1 text-white">500+</h3>
                                        <small class="text-white-50 d-block">Happy Users</small>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <div class="stat-item">
                                        <h3 class="fw-bold mb-1 fs-2 fs-sm-1 text-white">50+</h3>
                                        <small class="text-white-50 d-block">Mood Categories</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="hero-actions d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                            <a href="/Home/Dashboard" class="btn btn-light btn-lg hover-lift px-4 py-3">
                                <i class="fas fa-chart-line me-2"></i>View Dashboard
                            </a>
                            <a href="/Playlist/Create" class="btn btn-outline-light btn-lg hover-lift px-4 py-3">
                                <i class="fas fa-magic me-2"></i>Generate Playlist
                            </a>
                        </div>
                    }
                </div>
            </div>
            
            <div class="col-12 col-lg-6 order-lg-2">
                <div class="hero-visual position-relative mt-4 mt-lg-0 animate-fade-in-right animate-delay-2">
                    <!-- Vinyl Record Player Mockup -->
                    <div class="vinyl-player mx-auto" style="max-width: 420px;">
                        <div class="player-card glass-effect p-4 rounded-4 position-relative overflow-hidden">
                            <!-- Turntable Base -->
                            <div class="turntable-base position-relative">
                                <!-- Vinyl Record -->
                                <div class="vinyl-record spinning">
                                    <div class="vinyl-outer-ring"></div>
                                    <div class="vinyl-grooves"></div>
                                    <div class="vinyl-label">
                                        <div class="label-text">
                                            <div class="track-title-vinyl">Dreamy</div>
                                            <div class="track-title-vinyl">Acoustic</div>
                                            <div class="track-title-vinyl">Vibes</div>
                                        </div>
                                    </div>
                                    <div class="vinyl-center-hole"></div>
                                </div>
                                
                                <!-- Tonearm -->
                                <div class="tonearm">
                                    <div class="tonearm-base"></div>
                                    <div class="tonearm-arm"></div>
                                    <div class="tonearm-needle"></div>
                                </div>
                                
                                <!-- Turntable Info -->
                                <div class="turntable-info position-absolute bottom-0 start-0 end-0 p-3">
                                    <div class="d-flex justify-content-between align-items-center text-white">
                                        <div class="track-info-vinyl">
                                            <div class="track-name">Dreamy Acoustic Vibes</div>
                                            <div class="track-artist">Generated Playlist</div>
                                        </div>
                                        <div class="vinyl-controls d-flex gap-2">
                                            <button class="vinyl-btn" title="Previous">
                                                <i class="fas fa-step-backward"></i>
                                            </button>
                                            <button class="vinyl-btn vinyl-play-btn" title="Play/Pause">
                                                <i class="fas fa-play"></i>
                                            </button>
                                            <button class="vinyl-btn" title="Next">
                                                <i class="fas fa-step-forward"></i>
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <!-- Progress Bar -->
                                    <div class="vinyl-progress mt-3">
                                        <div class="progress-track">
                                            <div class="progress-fill" style="width: 60%;"></div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-2 small text-white-50">
                                            <span>2:34</span>
                                            <span>4:12</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Mood Tags -->
                            <div class="mood-tags-modern d-flex flex-wrap gap-2 justify-content-center mt-4">
                                <span class="mood-pill active">😌 Relaxed</span>
                                <span class="mood-pill">🎵 Acoustic</span>
                                <span class="mood-pill">☀️ Sunny</span>
                                <span class="mood-pill">🌙 Evening</span>
                            </div>
                        </div>
                        
                        <!-- Stats Cards -->
                        <div class="player-stats row g-3 mt-4">
                            <div class="col-4">
                                <div class="stat-card glass-effect p-3 rounded-3 text-center">
                                    <div class="stat-number text-white fw-bold fs-5">67</div>
                                    <div class="stat-label text-white-50 small">Songs</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-card glass-effect p-3 rounded-3 text-center">
                                    <div class="stat-number text-white fw-bold fs-5">67K</div>
                                    <div class="stat-label text-white-50 small">Plays</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-card glass-effect p-3 rounded-3 text-center">
                                    <div class="stat-number text-white fw-bold fs-5">4.8</div>
                                    <div class="stat-label text-white-50 small">Rating</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Enhanced Floating Elements -->
                    <div class="floating-elements d-none d-lg-block">
                        <div class="floating-note note-1">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="floating-note note-2">
                            <i class="fas fa-headphones"></i>
                        </div>
                        <div class="floating-note note-3">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="floating-note note-4">
                            <i class="fas fa-star"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (!User.Identity!.IsAuthenticated)
{
    <!-- Features Section -->
    <section class="features-section py-5">
        <div class="container-fluid px-3 px-md-4">
            <div class="row justify-content-center">
                <div class="col-12 col-xl-10">
                    <div class="text-center mb-5 animate-fade-in-up">
                        <h2 class="fw-bold mb-3 display-5 text-dark">How MoodTunes Works</h2>
                        <p class="lead text-secondary fs-4">Three simple steps to your perfect playlist</p>
                    </div>
                    
                    <div class="row g-4 justify-content-center">
                        <div class="col-12 col-md-6 col-lg-4 animate-fade-in-up animate-delay-1">
                            <div class="feature-card card h-100 border-0 shadow-sm hover-lift">
                                <div class="card-body text-center p-4 p-lg-5">
                                    <div class="feature-icon mb-4">
                                        <div class="icon-circle bg-primary bg-opacity-10 mx-auto">
                                            <i class="fas fa-compact-disc text-primary fs-2"></i>
                                        </div>
                                    </div>
                                    <h4 class="fw-semibold mb-3 text-dark">Add Your Music</h4>
                                    <p class="text-secondary mb-0">
                                        Import your favorite YouTube songs and organize them 
                                        in your personal music library with ease.
                                    </p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12 col-md-6 col-lg-4 animate-fade-in-up animate-delay-2">
                            <div class="feature-card card h-100 border-0 shadow-sm hover-lift">
                                <div class="card-body text-center p-4 p-lg-5">
                                    <div class="feature-icon mb-4">
                                        <div class="icon-circle bg-success bg-opacity-10 mx-auto">
                                            <i class="fas fa-heart text-success fs-2"></i>
                                        </div>
                                    </div>
                                    <h4 class="fw-semibold mb-3 text-dark">Tag Your Moods</h4>
                                    <p class="text-secondary mb-0">
                                        Categorize songs by mood - Happy, Sad, Energetic, 
                                        Relaxed, Romantic, Focus and many more emotions.
                                    </p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12 col-md-6 col-lg-4 animate-fade-in-up animate-delay-3">
                            <div class="feature-card card h-100 border-0 shadow-sm hover-lift">
                                <div class="card-body text-center p-4 p-lg-5">
                                    <div class="feature-icon mb-4">
                                        <div class="icon-circle bg-warning bg-opacity-10 mx-auto">
                                            <i class="fas fa-magic text-warning fs-2"></i>
                                        </div>
                                    </div>
                                    <h4 class="fw-semibold mb-3 text-dark">Generate Playlists</h4>
                                    <p class="text-secondary mb-0">
                                        Let our algorithm create perfect playlists based on 
                                        your selected mood and listening preferences.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- CTA Section -->
    <section class="cta-section py-5 bg-light">
        <div class="container-fluid px-3 px-md-4">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-8 col-xl-6 text-center animate-fade-in-up">
                    <h2 class="fw-bold mb-4 display-5 text-dark">Ready to Transform Your Music Experience?</h2>
                    <p class="lead text-secondary mb-5 fs-5">
                        Join thousands of music lovers who've already discovered 
                        the perfect way to organize and enjoy their favorite songs.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                        <a href="/Account/Register" class="btn btn-primary btn-lg hover-lift px-5 py-3">
                            <i class="fas fa-rocket me-2"></i>Get Started for Free
                        </a>
                        <a href="#features" class="btn btn-outline-primary btn-lg hover-lift px-5 py-3">
                            <i class="fas fa-info-circle me-2"></i>Learn More
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
